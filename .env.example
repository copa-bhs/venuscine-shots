# ═══════════════════════════════════════════════════════
# CONFIGURAÇÃO DA API
# ═══════════════════════════════════════════════════════

# Site de origem (de onde a API faz scraping) — NÃO MUDE
REELSHORT_BASE_URL=https://www.reelshort.com

# Idioma do conteúdo raspado
REELSHORT_LANG=pt

# Tempo de cache em segundos (600 = 10 minutos)
REELSHORT_CACHE_TTL=600

# Porta interna onde o Gunicorn vai rodar (Nginx redireciona pra cá)
SHORTS_PORT=5000