
---

## 📄 `deploy/reelshort.service`

```ini
[Unit]
Description=ReelShort API Server
After=network.target

[Service]
Type=simple
User=reelshort
Group=reelshort
WorkingDirectory=/var/www/reelshort
EnvironmentFile=/var/www/reelshort/.env
ExecStart=/var/www/reelshort/venv/bin/gunicorn \
    --workers 4 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    server:app

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target